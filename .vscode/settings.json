{
  "cSpell.words": [
    "azkivam",
    "bandar",
    "Chamrun",
    "chargeback",
    "Codabar",
    "CODEBAR",
    "cuid",
    "digipay",
    "exprimentalpnpm",
    "fastify",
    "formbody",
    "jwtid",
    "KEEPTTL",
    "Khuzestan",
    "Mahshahr",
    "metatype",
    "tipax",
    "Undoable"
  ],
  "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
  "todo-tree.tree.showBadges": true,
  "todo-tree.highlights.enabled": false,
  "todo-tree.general.tags": [
    "BUG",
    "HACK",
    "FIXME",
    "TODO",
    "XXX",
    "[ ]",
    "[x]",
    "[NOTE]",
    "[TODO]"
  ],
  "js/ts.experimental.useTsgo": true,
  "oxc.fixKind": "safe_fix_or_suggestion",
  "oxc.disableNestedConfig": true,
  "editor.formatOnSave": false,
  "editor.formatOnSaveMode": "file",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always",
    "source.format.oxc": "always"
  },

  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.updateImportsOnPaste.enabled": false,
  "js/ts.updateImportsOnFileMove.enabled": "never",

  // "js/ts.preferences.autoImportFileExcludePatterns": [
  //   "**/features/**/{api,impl,http,ws}/**/!(index).ts"
  // ],
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.autoImportSpecifierExcludeRegexes": [
    // relative که وارد پوشه‌ی لایه‌ی یک ماژول دیگر می‌شود (../x/api/..., ../../x/y/impl/...)
    "^(\\.\\./)+([^/]+/)*(api|impl|http|ws)(/.*)?$",

    // alias: هر چیزی داخل پکیج یک لایه، به‌جز خود ریشه یا index
    "^@features/.+/(api|impl|http|ws)/(?!index(\\.[jt]s)?$).+$",
    "^@shared/(api|impl|http|ws)/(?!index(\\.[jt]s)?$).+$",
    "^@shared/[^/]+/.+$",
    "^@infrastructure/[^/]+/.+$"
  ]
}
