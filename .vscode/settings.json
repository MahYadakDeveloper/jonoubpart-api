{
  "cSpell.words": [
    "azkivam",
    "bandar",
    "barcodes",
    "Chamrun",
    "chargeback",
    "Codabar",
    "CODEBAR",
    "cuid",
    "digipay",
    "exprimentalpnpm",
    "fastify",
    "formbody",
    "jwtid",
    "KEEPTTL",
    "Khuzestan",
    "Mahshahr",
    "metatype",
    "tipax",
    "Undoable"
  ],
  "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
  "todo-tree.tree.showBadges": true,
  "todo-tree.highlights.enabled": false,
  "todo-tree.general.tags": [
    "BUG",
    "HACK",
    "FIXME",
    "TODO",
    "XXX",
    "[ ]",
    "[x]",
    "[NOTE]",
    "[TODO]"
  ],
  "js/ts.experimental.useTsgo": true,
  "oxc.fixKind": "safe_fix_or_suggestion",
  "oxc.disableNestedConfig": true,
  "editor.formatOnSave": false,
  "editor.formatOnSaveMode": "file",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always",
    "source.format.oxc": "always"
  },

  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.updateImportsOnPaste.enabled": false,
  "js/ts.updateImportsOnFileMove.enabled": "never",

  "js/ts.preferences.importModuleSpecifier": "non-relative",

  // Auto-import must only offer the entry point of a package, never an
  // internal file or an internal index.ts nested below it:
  //   @<group>/<feature>[/<submodule>...]/<layer>   (layer index only)
  //   @<group>/schema                               (group schema)
  //   @shared/<name>, @infrastructure/<name>
  // Settings are a regular submodule (<modulePath>/settings/<layer>), covered
  // by the same rules. The group list must match the aliases in tsconfig.json
  // (commerce|logistics|payments|finance|platform|iam).
  "js/ts.preferences.autoImportSpecifierExcludeRegexes": [
    // Relative paths that reach into a layer folder (use the alias instead)
    "^(\\.\\./)+([^/]+/)*(api|impl|http|ws|schema)(/.*)?$",

    // Relative paths that reach into shared or infrastructure
    "^(\\.\\./)+(shared|infrastructure)(/.*)?$",

    // Feature layers: anything below <layer>/ (internal files and internal
    // index.ts files), only @<...>/<layer> itself stays
    "^@(commerce|logistics|payments|finance|platform|iam)/.+/(api|impl|http|ws|schema)/.+$",

    // Group schema: only the entry point @<group>/schema, nothing deeper
    "^@(commerce|logistics|payments|finance|platform|iam)/schema/.+$",

    // Shared and infrastructure: only @shared/<name> and
    // @infrastructure/<name>; anything deeper (e.g. @shared/impl/types, which
    // the `*` in the tsconfig alias would otherwise resolve) is excluded
    "^@shared/[^/]+/.+$",
    "^@infrastructure/[^/]+/.+$"
  ]
}
