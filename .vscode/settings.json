{
  "cSpell.words": [
    "azkivam",
    "bandar",
    "Chamrun",
    "chargeback",
    "Codabar",
    "CODEBAR",
    "cuid",
    "digipay",
    "exprimentalpnpm",
    "fastify",
    "formbody",
    "jwtid",
    "KEEPTTL",
    "Khuzestan",
    "Mahshahr",
    "metatype",
    "tipax",
    "Undoable"
  ],
  "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
  "todo-tree.tree.showBadges": true,
  "todo-tree.highlights.enabled": false,
  "todo-tree.general.tags": [
    "BUG",
    "HACK",
    "FIXME",
    "TODO",
    "XXX",
    "[ ]",
    "[x]",
    "[NOTE]",
    "[TODO]"
  ],
  "js/ts.experimental.useTsgo": true,
  "oxc.fixKind": "safe_fix_or_suggestion",
  "oxc.disableNestedConfig": true,
  "editor.formatOnSave": false,
  "editor.formatOnSaveMode": "file",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always",
    "source.format.oxc": "always"
  },

  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.updateImportsOnPaste.enabled": false,
  "js/ts.updateImportsOnFileMove.enabled": "never",

  "js/ts.preferences.importModuleSpecifier": "non-relative",

  // Auto-import must only offer the public entry point of a layer package:
  //   @<group>/<feature>[/<submodule>...]/<layer>   (never a deeper file)
  // The group list below must match the aliases in tsconfig.json
  // (commerce|logistics|payments|finance|platform|iam).
  "js/ts.preferences.autoImportSpecifierExcludeRegexes": [
    // Relative paths that reach into a layer folder
    "^(\\.\\./)+([^/]+/)*(api|impl|http|ws|schema)(/.*)?$",

    // Feature layers: anything below <layer>/ except its index
    "^@(commerce|logistics|payments|finance|platform|iam)/.+/(api|impl|http|ws|schema)/(?!index(\\.[jt]s)?$).+$",

    // Group schema: only the entry point @<group>/schema, nothing deeper
    "^@(commerce|logistics|payments|finance|platform|iam)/schema/.+$",

    // Shared and infrastructure: anything below the first-level module
    "^@shared/(api|impl|http|ws)/(?!index(\\.[jt]s)?$).+$",
    "^@shared/[^/]+/.+$",
    "^@infrastructure/[^/]+/.+$"
  ]
}
